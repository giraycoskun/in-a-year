DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inayear
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inayear
UPLOAD_DIR=./uploads

# Trakt API - Get credentials from https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret
TRAKT_API_URL=https://api.trakt.tv

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# TMDB API - Get API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key
TMDB_API_URL=https://api.themoviedb.org/3

# ML Model
ML_MODEL_PATH=ml/models
